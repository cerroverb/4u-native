--- a/plume_vulkan.cpp
+++ b/plume_vulkan.cpp
@@ -4474,6 +4474,7 @@ namespace plume {
         allocatorInfo.pVulkanFunctions = &vmaFunctions;
         allocatorInfo.instance = renderInterface->instance;
         allocatorInfo.vulkanApiVersion = renderInterface->appInfo.apiVersion;
+        allocatorInfo.preferredLargeHeapBlockSize = extras.allocatorBlockSize; // mh4n (patch 18): 0 is VMA's default
 
         res = vmaCreateAllocator(&allocatorInfo, &allocator);
         if (res != VK_SUCCESS) {
